</section>

<main id="app"><!-- rendered by JS --></main>

<!-- ============ EMAIL MODAL ============ -->
<div class="modal-bg" id="emailModal">
  <div class="modal">
    <span class="x" onclick="closeModal()">[ esc ]</span>
    <div class="glbl" id="emGlbl">Free report</div>
    <h3 id="emTitle">Open your free full report</h3>
    <p id="emBody">You get one full-spectrum report on the house. Drop an email and the depth unlocks - provenance, the strongest opposition, the timeline.</p>
    <form onsubmit="submitEmail(event)">
      <input type="email" id="emailInput" placeholder="you@domain.com" required>
      <button class="btn primary" type="submit" id="emCta">Unlock the full report</button>
      <div class="fine">Demo only - no email is stored or sent.</div>
    </form>
  </div>
</div>

<!-- ============ FOOTER ============ -->
<footer>
  <div class="foot-brand">
    <svg viewBox="0 0 820 540" aria-hidden="true"><g fill="none" stroke="#E5342B" stroke-width="40" stroke-linecap="round" stroke-linejoin="round"><path d="M132 152 C290 80 530 80 690 150"/><path d="M150 252 C300 168 512 170 662 214"/><path d="M662 214 C548 300 322 312 150 252"/><path d="M322 306 C318 376 322 432 292 476"/><path d="M470 300 C582 360 700 360 712 286 C718 246 668 242 678 296"/></g><circle cx="400" cy="244" r="52" fill="#E5342B"/></svg>
    HORUS
  </div>
  <div class="meta" id="footMeta">All sides. The shape of the evidence. You decide. &nbsp;//&nbsp; seeded demo</div>
