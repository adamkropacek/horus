/* ===================== STATE ===================== */
const state = {
  mode: "free",          // free | pro
  view: "board",         // board | event
  eventId: null,
  filter: "all",
  query: "",
  emailCaptured: false,
  freeReportUsed: false,
  unlocked: null,        // eventId that the free report was spent on
  pendingUnlock: null,
};

const KIND_ABBR = {
  "state media":"STATE","wire service":"WIRE","journalist":"JRNL","official record":"OFF.REC",
  "independent OSINT":"OSINT","research paper":"PAPER","market research":"MARKET","public debate":"DEBATE"
};

function esc(s){return String(s==null?"":s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;"}[c]));}
function fmtNum(n){if(n>=1e6)return (n/1e6).toFixed(n>=1e7?0:1)+"M";if(n>=1000)return (n/1000).toFixed(n>=10000?0:1)+"k";return String(n);}

/* ===================== RENDER ===================== */
const app = () => document.getElementById("app");

function render(){
  document.getElementById("tFree").classList.toggle("on", state.mode==="free");
  document.getElementById("tPro").classList.toggle("on", state.mode==="pro");
  document.getElementById("taglineBadge").textContent = "NO VERDICT";
  const gw=document.getElementById("globeWrap");
  if(gw) gw.classList.toggle("show", state.view==="board"); // globe is the board hero only; never leaks onto event view
  if(state.view==="board") renderBoard(); else renderEvent(state.eventId);
  window.scrollTo({top:0,behavior:"instant"});
}

function renderBoard(){
  const evs = SEED.events.filter(e=>{
    const okScope = state.filter==="all" || e.scope===state.filter;
    const q = state.query.trim().toLowerCase();
    const okQ = !q || (e.title+" "+e.neutralLine).toLowerCase().includes(q);
    return okScope && okQ;
  });
  const scopes = ["all","geopolitics","markets","tech","conflict"];
  const totalClaims = SEED.events.reduce((a,e)=>a+e.claims.length,0);
  const mc = SEED.microcopy;

  app().innerHTML = `
    <div class="kicker"><span class="n">//</span> 01 &nbsp; SITUATION MONITOR</div>
    <div class="board-head">
      <div>
        <h1>What the world is arguing about</h1>
        <p>${esc(mc.noVerdictExplainer)}</p>
      </div>
      <div class="statrow">
        <div class="stat"><div class="v">${SEED.events.length}</div><div class="l">situations tracked</div></div>
        <div class="stat"><div class="v">${totalClaims}</div><div class="l">competing claims</div></div>
        <div class="stat"><div class="v">8</div><div class="l">source kinds</div></div>
      </div>
    </div>
    <div class="controls">
      <div class="filters">
        ${scopes.map(s=>`<div class="chip ${state.filter===s?"on":""}" onclick="setFilter('${s}')">${s}</div>`).join("")}
      </div>
      <label class="search">
        <span class="mute mono">⌕</span>
        <input id="searchInput" placeholder="search situations" value="${esc(state.query)}" oninput="onSearch(this.value)">
      </label>
    </div>
    <div class="grid">
      ${evs.map(cardHTML).join("") || `<p class="mute">No events match.</p>`}
    </div>
  `;
  const si = document.getElementById("searchInput");
  if(si && state.query){ si.focus(); si.setSelectionRange(si.value.length, si.value.length); }
}

function cardHTML(e){
  const kinds = new Set();
  e.claims.forEach(c=>c.carriers.forEach(cr=>kinds.add(cr.kind)));
  const bars = Math.min(8, Math.max(3, kinds.size));
  return `
    <div class="card" data-act="open" data-id="${esc(e.id)}">
      <div class="card-top">
        <span class="tag ${e.scope}">${esc(e.scope)}</span>
        <span class="pill ${e.status}">${esc(e.status)}</span>
      </div>
      <h3>${esc(e.title)}</h3>
      <div class="line">${esc(e.neutralLine)}</div>
      <div class="spectrum-bar">${Array.from({length:8},(_,i)=>`<span style="background:${i<bars?(i%3===0?'var(--red)':i%3===1?'var(--cyan)':'var(--mute2)'):'var(--line)'}"></span>`).join("")}</div>
      <div class="card-foot">
        <span>${e.claims.length} claims &nbsp;//&nbsp; ${kinds.size} source kinds</span>
        <span class="att" title="Attention shape - NOT a credibility signal."><span class="dotpulse"></span>${fmtNum(e.watchers)} watching</span>
      </div>
    </div>`;
}

function carrierHTML(cr){
  const primClass = cr.primacy==="primary"?"prim":"";
  const provClass = cr.provenance==="echo"?"echo":"orig";
  return `
    <div class="carrier" title="${esc(cr.motive)}">
      <span class="src">${esc(cr.source)}</span>
      <span class="kind">${KIND_ABBR[cr.kind]||esc(cr.kind)}</span>
      <span class="attr">${cr.named?"named":"anon"}</span>
      <span class="attr ${primClass}">${esc(cr.primacy)}</span>
      <span class="attr ${provClass}">${esc(cr.provenance)}</span>
      <span class="motive"><b>why</b> &nbsp;${esc(cr.motive)}</span>
    </div>`;
}

function claimHTML(c){
  return `
    <div class="claim">
      <div class="stmt">${esc(c.statement)}</div>
      <div class="carriers">${c.carriers.map(carrierHTML).join("")}</div>
      <div class="strongest"><b>strongest evidence</b>${esc(c.strongest)}</div>
      <div class="opp">
        <div class="lbl">↺ strongest opposition</div>
        <div class="stmt2">${esc(c.opposition.statement)}</div>
        <div class="carriers">${c.opposition.carriers.map(carrierHTML).join("")}</div>
        <div class="why"><b>why it bites:</b> ${esc(c.opposition.why)}</div>
      </div>
    </div>`;
}

function legendHTML(){
  const mc = SEED.microcopy;
  return `
    <div class="legend">
      <details>
        <summary>source KIND legend</summary>
        <div class="body">${mc.kindLegend.map(k=>`<div><b>${esc(k.kind)}</b> - ${esc(k.def)}</div>`).join("")}</div>
      </details>
      <details>
        <summary>primacy / provenance</summary>
        <div class="body">${mc.primacyLegend.map(k=>`<div><b>${esc(k.term)}</b> - ${esc(k.def)}</div>`).join("")}</div>
      </details>
    </div>`;
}

function depthLocked(eventId){
  if(state.mode==="pro") return false;
  if(state.unlocked===eventId) return false;
  return true;
}

function renderEvent(id){
  const e = SEED.events.find(x=>x.id===id);
  const mc = SEED.microcopy;
  if(!e){ app().innerHTML = `<p class="mute">${esc(mc.emptyState)}</p>`; return; }

  const locked = depthLocked(id);

  // FREE: the history spine + the spectrum of claims (with provenance + opposition).
  // GATED: manufactured-consensus watch + forward scenarios.
  const claimsBlock = e.claims.map(claimHTML).join("");

  // WHERE IT STANDS NOW = the most recent recorded beat on the timeline (no synthesis, no verdict).
  const latest = (e.timeline&&e.timeline.length)
    ? e.timeline.reduce((a,b)=> (b.date>a.date ? b : a))
    : null;
  const standsNow = latest ? `
      <div class="standsnow">
        <span class="snlbl">where it stands now</span>
        <span class="sntxt"><span class="snd">${esc(latest.date)}</span>${esc(latest.event)}</span>
      </div>` : "";

  // HOW IT GOT HERE = the situation's history, promoted to a FREE primary section under the header.
  const timelineBlock = (e.timeline&&e.timeline.length) ? `
    <div class="kicker"><span class="n">//</span> HOW IT GOT HERE &nbsp; the situation's history</div>
    <div class="section">
      <div class="timeline">
        ${e.timeline.map(t=>`<div class="tl-item"><div class="d">${esc(t.date)}</div><div class="e">${esc(t.event)}</div><div class="s">${esc(t.shift)}</div></div>`).join("")}
      </div>
    </div>` : "";

  const mfgBlock = e.manufacturedConsensus ? `
    <div class="mfg"><div class="lbl">⚠ manufactured consensus watch</div>${esc(e.manufacturedConsensus)}</div>` : "";
  const scenBlock = (e.scenarios&&e.scenarios.length) ? `
    <div class="section">
      <div class="section-h"><h2>Scenarios</h2><span class="sub">// theories, never predictions</span></div>
      ${e.scenarios.map(s=>`
        <div class="scenario">
          <div class="lbl">⟶ theory</div>
          <div class="st">${esc(s.statement)}</div>
          <div class="rests"><b>rests on</b><ul>${s.restsOn.map(r=>`<li>${esc(r)}</li>`).join("")}</ul></div>
          <div class="note">${esc(s.note)}</div>
        </div>`).join("")}
    </div>` : "";

  const hasDepth = !!mfgBlock || !!(e.scenarios&&e.scenarios.length);
  const depthInner = `${mfgBlock}${scenBlock}`;

  const gate = state.freeReportUsed
    ? `<div class="gate-card">
         <div class="glbl">depth locked</div>
         <h3>${esc(mc.proGate.title)}</h3>
         <p>${esc(mc.proGate.body)}</p>
         <ul>${mc.proGate.bullets.map(b=>`<li>${esc(b)}</li>`).join("")}</ul>
         <button class="btn primary" onclick="setMode('pro')">${esc(mc.proGate.cta)}</button>
         <div class="fine">${esc(mc.methodologyNote)}</div>
       </div>`
    : `<div class="gate-card">
         <div class="glbl">free report</div>
         <h3>Open your one free full report</h3>
         <p>The history and every side above are always free. Unlock the last layer - the manufactured-consensus watch and the forward scenarios - on this situation, on the house.</p>
         <button class="btn primary" data-act="askEmail" data-id="${esc(id)}">Unlock the full report - free</button>
         <div class="fine">No card. Email only. ${esc(mc.methodologyNote)}</div>
       </div>`;

  const depthSection = hasDepth ? `
    <div class="kicker"><span class="n">//</span> THE DEPTH &nbsp; the consensus watch + the scenarios${locked?` <span class="mute">- ${state.mode==="free"?"free/Pro":"locked"}</span>`:""}</div>
    ${locked
      ? `<div class="locked-wrap"><div class="blurred">${depthInner}</div><div class="gate">${gate}</div></div>`
      : depthInner}` : "";

  app().innerHTML = `
    <div class="back" onclick="goBoard()">← &nbsp; back to monitor</div>
    <div class="ev-head">
      <div class="toprow">
        <span class="tag ${e.scope}">${esc(e.scope)}</span>
        <span class="pill ${e.status}">${esc(e.status)}</span>
        <span class="noverdict">NO VERDICT</span>
      </div>
      <h1>${esc(e.title)}</h1>
      <div class="neutral">${esc(e.neutralLine)}</div>
      ${standsNow}
      <div class="att-line">
        <span><span class="dotpulse"></span> &nbsp;${fmtNum(e.watchers)} watching <span class="mute">(attention shape, not credibility)</span></span>
        <span>${e.claims.length} competing claims</span>
      </div>
    </div>

    ${timelineBlock}

    <div class="kicker"><span class="n">//</span> THE SPECTRUM &nbsp; every side, side by side</div>
    ${legendHTML()}
    <div class="section">${claimsBlock}</div>

    ${depthSection}
  `;
}

/* ===================== ACTIONS ===================== */
function setMode(m){ state.mode=m; render(); }
function setFilter(f){ state.filter=f; render(); }
function onSearch(v){ state.query=v; renderBoard(); }
function openEvent(id){ state.view="event"; state.eventId=id; render(); }
function goBoard(){ state.view="board"; render(); }

function askEmail(id){
  if(state.emailCaptured){ // already gave email earlier -> spend the free report directly
    state.freeReportUsed=true; state.unlocked=id; render(); return;
  }
  state.pendingUnlock=id;
  document.getElementById("emailModal").classList.add("show");
  setTimeout(()=>{const i=document.getElementById("emailInput"); if(i) i.focus();},50);
}
function closeModal(){ document.getElementById("emailModal").classList.remove("show"); }
function submitEmail(ev){
  ev.preventDefault();
  state.emailCaptured=true;
  state.freeReportUsed=true;
  state.unlocked=state.pendingUnlock;
  closeModal();
  render();
}
document.addEventListener("keydown",e=>{ if(e.key==="Escape") closeModal(); });

/* ===================== CLOCK ===================== */
function tick(){
  const d=new Date();
  const p=n=>String(n).padStart(2,"0");
  const el=document.getElementById("clock");
  if(el) el.textContent=`${p(d.getUTCHours())}:${p(d.getUTCMinutes())}:${p(d.getUTCSeconds())} UTC`;
}
setInterval(tick,1000); tick();

/* ===================== BOOT ===================== */
/* delegated clicks - #app persists across renders, only its innerHTML changes */
document.getElementById("app").addEventListener("click", (ev)=>{
  const t = ev.target.closest("[data-act]");
  if(!t) return;
  const act = t.dataset.act, id = t.dataset.id;
  if(act==="open") openEvent(id);
  else if(act==="askEmail") askEmail(id);
});
document.getElementById("footMeta").textContent = SEED.microcopy.tagline + "  //  seeded demo";

/* ===================== GLOBE HERO ===================== */
/* The globe is the WRAPPER (the way in). The evidence engine below is the PRODUCT. */
const GEO_MARKERS = SEED.events.filter(e=>e.geo).map(e=>({
  id:e.id, lat:e.geo.lat, lng:e.geo.lng, place:e.geo.place,
  title:e.title, scope:e.scope, status:e.status
}));
let globeInstance=null;
function webglOK(){
  try{ const c=document.createElement("canvas");
    return !!(window.WebGLRenderingContext && (c.getContext("webgl")||c.getContext("experimental-webgl"))); }
  catch(_){ return false; }
}
function initGlobe(){
  const wrap=document.getElementById("globeWrap");
  const stage=document.getElementById("globeStage");
  const host=document.getElementById("globe");
  const cnt=document.getElementById("globeCount");
  if(cnt) cnt.textContent=GEO_MARKERS.length;
  if(!wrap||!stage||!host) return;
  if(typeof Globe==="undefined" || !webglOK()){ wrap.classList.add("globe-failed"); return; } // fall back to the list below
  try{
    globeInstance=Globe()(host)
      .width(stage.clientWidth).height(stage.clientHeight)
      .backgroundColor("rgba(0,0,0,0)")
      .globeImageUrl("https://unpkg.com/three-globe/example/img/earth-dark.jpg")
      .showAtmosphere(true).atmosphereColor("#E5342B").atmosphereAltitude(0.16)
      .pointsData(GEO_MARKERS).pointLat("lat").pointLng("lng")
      .pointColor(()=> "#E5342B").pointAltitude(0.06).pointRadius(0.55)
      .pointLabel(d=>`<div style="background:#111317;border:1px solid #23262E;border-radius:8px;padding:8px 10px;max-width:240px;box-shadow:0 6px 24px rgba(0,0,0,.5)"><div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.1em;color:#E5342B;text-transform:uppercase;margin-bottom:3px">${d.scope} // ${d.place}</div><div style="font-family:Inter,sans-serif;font-size:12.5px;line-height:1.35;color:#EDEEF0">${d.title}</div><div style="font-family:'JetBrains Mono',monospace;font-size:10px;color:#8A8F98;margin-top:5px">click to open</div></div>`)
      .onPointClick(d=> openEvent(d.id))
      .ringsData(GEO_MARKERS).ringLat("lat").ringLng("lng")
      .ringColor(()=> (t)=> `rgba(229,52,43,${1-t})`)
      .ringMaxRadius(4.5).ringPropagationSpeed(1.4).ringRepeatPeriod(1300);
    globeInstance.pointOfView({lat:25,lng:12,altitude:2.3},0);
    const ctr=globeInstance.controls();
    ctr.autoRotate=true; ctr.autoRotateSpeed=0.5; ctr.enableZoom=false; // wheel scrolls the page, not the globe
  }catch(err){ console.warn("globe init failed:",err); wrap.classList.add("globe-failed"); globeInstance=null; }
}
window.addEventListener("load", initGlobe);
window.addEventListener("resize", ()=>{
  if(!globeInstance) return;
  const stage=document.getElementById("globeStage");
  if(!stage || stage.offsetParent===null) return; // skip while hidden (event view)
  globeInstance.width(stage.clientWidth).height(stage.clientHeight);
});

render();
