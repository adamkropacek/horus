<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HORUS // full-spectrum terminal</title>
<link rel="icon" type="image/svg+xml" href="favicon.svg">
<link rel="mask-icon" href="favicon.svg" color="#E5342B">
<meta name="description" content="HORUS demo - all sides, the shape of the evidence, no verdict. Full-spectrum source comparison for geopolitics, market-movers and world-movers.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"></noscript>
<style>
:root{
  --bg:#0A0A0B; --surf:#111317; --surf2:#15181E; --line:#23262E;
  --red:#E5342B; --red-deep:#C8102E;
  --ink:#EDEEF0; --mute:#8A8F98; --mute2:#C7CBD1; --cyan:#3FB6C8;
  --mono:"JetBrains Mono",ui-monospace,monospace;
  --ui:"Inter","Segoe UI",sans-serif;
  --display:"Space Grotesk","Inter",sans-serif;
  --radius:10px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{font-size:16px}
body{
  background:var(--bg); color:var(--ink); font-family:var(--ui);
  line-height:1.5; -webkit-font-smoothing:antialiased;
  min-height:100vh;
  background-image:
    radial-gradient(900px 500px at 80% -10%, rgba(229,52,43,.07), transparent 60%),
    linear-gradient(rgba(255,255,255,.012) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.012) 1px, transparent 1px);
  background-size:auto, 44px 44px, 44px 44px;
}
a{color:inherit;text-decoration:none}
.mono{font-family:var(--mono)}
.disp{font-family:var(--display)}
.mute{color:var(--mute)}
.cyan{color:var(--cyan)}
.red{color:var(--red)}

/* ---------- top bar ---------- */
header{
  position:sticky; top:0; z-index:40;
  display:flex; align-items:center; gap:18px;
  padding:14px 22px; border-bottom:1px solid var(--line);
  background:rgba(10,10,11,.86); backdrop-filter:blur(10px);
}
.brand{display:flex; align-items:center; gap:11px; font-family:var(--display); font-weight:700; letter-spacing:.06em; font-size:1.15rem; cursor:pointer}
.brand svg{width:34px; height:auto; display:block}
.statusline{font-family:var(--mono); font-size:.72rem; color:var(--mute); letter-spacing:.04em}
.statusline b{color:var(--ink); font-weight:500}
.spacer{flex:1}
.tier-toggle{display:flex; border:1px solid var(--line); border-radius:99px; overflow:hidden; font-family:var(--mono); font-size:.7rem}
.tier-toggle button{background:transparent; color:var(--mute); border:0; padding:7px 15px; cursor:pointer; letter-spacing:.08em; transition:.15s}
.tier-toggle button.on{background:var(--red); color:#fff}
.tier-toggle button.on.pro{background:var(--cyan); color:#06222a}
.noverdict{font-family:var(--mono); font-size:.68rem; letter-spacing:.12em; color:var(--red); border:1px solid rgba(229,52,43,.4); padding:5px 11px; border-radius:99px; white-space:nowrap}

/* ---------- layout ---------- */
main{max-width:1340px; margin:0 auto; padding:26px 22px 90px}
.kicker{font-family:var(--mono); font-size:.72rem; letter-spacing:.16em; color:var(--mute); text-transform:uppercase}
.kicker .n{color:var(--red)}

/* ---------- board ---------- */
.board-head{display:flex; align-items:flex-end; justify-content:space-between; gap:20px; flex-wrap:wrap; margin-bottom:18px}
.board-head h1{font-family:var(--display); font-weight:600; font-size:clamp(1.5rem,3vw,2.1rem); letter-spacing:-.01em; margin-top:6px}
.board-head p{color:var(--mute2); max-width:560px; font-size:.95rem; margin-top:4px}
.statrow{display:flex; gap:10px; flex-wrap:wrap}
.stat{border:1px solid var(--line); background:var(--surf); border-radius:var(--radius); padding:9px 14px; min-width:96px}
.stat .v{font-family:var(--display); font-weight:600; font-size:1.25rem}
.stat .l{font-family:var(--mono); font-size:.62rem; letter-spacing:.1em; color:var(--mute); text-transform:uppercase}

.controls{display:flex; gap:12px; flex-wrap:wrap; align-items:center; margin:18px 0 22px}
.filters{display:flex; gap:7px; flex-wrap:wrap}
.chip{font-family:var(--mono); font-size:.72rem; letter-spacing:.05em; color:var(--mute); border:1px solid var(--line); background:var(--surf); padding:7px 13px; border-radius:99px; cursor:pointer; transition:.15s; text-transform:uppercase}
.chip:hover{color:var(--ink); border-color:#33384300}
.chip.on{color:var(--ink); border-color:var(--red); background:rgba(229,52,43,.1)}
.search{flex:1; min-width:200px; max-width:340px; display:flex; align-items:center; gap:8px; border:1px solid var(--line); background:var(--surf); border-radius:99px; padding:7px 14px}
.search input{flex:1; background:transparent; border:0; color:var(--ink); font-family:var(--mono); font-size:.8rem; outline:none}
.search input::placeholder{color:var(--mute)}

.grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(330px,1fr)); gap:14px}
.card{
  border:1px solid var(--line); background:linear-gradient(180deg,var(--surf),#0e1014);
  border-radius:var(--radius); padding:17px 17px 15px; cursor:pointer; transition:.16s;
  display:flex; flex-direction:column; gap:11px; position:relative; overflow:hidden;
}
.card:hover{border-color:#3a404c; transform:translateY(-2px)}
.card::before{content:""; position:absolute; left:0; top:0; bottom:0; width:3px; background:var(--red); opacity:.0; transition:.16s}
.card:hover::before{opacity:.9}
.card-top{display:flex; align-items:center; justify-content:space-between; gap:8px}
.tag{font-family:var(--mono); font-size:.62rem; letter-spacing:.12em; text-transform:uppercase; padding:3px 8px; border-radius:5px; border:1px solid var(--line); color:var(--mute2)}
.tag.geopolitics{color:#e0a8a3; border-color:rgba(229,52,43,.35)}
.tag.markets{color:var(--cyan); border-color:rgba(63,182,200,.35)}
.tag.tech{color:#b9a9e6; border-color:#3a3553}
.tag.conflict{color:#e7b07f; border-color:#4a3a2c}
.pill{font-family:var(--mono); font-size:.6rem; letter-spacing:.1em; padding:3px 8px; border-radius:99px; text-transform:uppercase}
.pill.developing{color:var(--red); background:rgba(229,52,43,.12)}
.pill.aged{color:var(--mute); background:rgba(138,143,152,.12)}
.card h3{font-family:var(--display); font-weight:600; font-size:1.12rem; line-height:1.25; letter-spacing:-.01em}
.card .line{color:var(--mute2); font-size:.86rem; line-height:1.45}
.spectrum-bar{display:flex; gap:3px; height:7px; margin-top:2px}
.spectrum-bar span{flex:1; border-radius:2px; background:var(--line)}
.card-foot{display:flex; align-items:center; justify-content:space-between; font-family:var(--mono); font-size:.68rem; color:var(--mute); border-top:1px solid var(--line); padding-top:10px; margin-top:2px}
.card-foot .att{display:flex; align-items:center; gap:6px}
.dotpulse{width:6px;height:6px;border-radius:50%;background:var(--red);box-shadow:0 0 0 0 rgba(229,52,43,.6);animation:pulse 2.4s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(229,52,43,.5)}70%{box-shadow:0 0 0 7px rgba(229,52,43,0)}100%{box-shadow:0 0 0 0 rgba(229,52,43,0)}}

/* ---------- event view ---------- */
.back{display:inline-flex; align-items:center; gap:8px; font-family:var(--mono); font-size:.74rem; color:var(--mute); cursor:pointer; margin-bottom:16px; letter-spacing:.04em}
.back:hover{color:var(--ink)}
.ev-head{border:1px solid var(--line); background:var(--surf); border-radius:var(--radius); padding:20px 22px; margin-bottom:20px}
.ev-head .toprow{display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:10px}
.ev-head h1{font-family:var(--display); font-weight:600; font-size:clamp(1.4rem,3vw,2rem); letter-spacing:-.01em; line-height:1.15}
.ev-head .neutral{color:var(--mute2); font-size:1rem; margin-top:9px; max-width:760px}
.ev-head .att-line{font-family:var(--mono); font-size:.72rem; color:var(--mute); margin-top:13px; display:flex; gap:16px; flex-wrap:wrap}

.section{margin:26px 0}
.section-h{display:flex; align-items:baseline; gap:12px; margin-bottom:14px; border-bottom:1px solid var(--line); padding-bottom:9px}
.section-h h2{font-family:var(--display); font-weight:600; font-size:1.18rem; letter-spacing:.01em}
.section-h .sub{font-family:var(--mono); font-size:.7rem; color:var(--mute); letter-spacing:.04em}

.legend{display:flex; gap:7px; flex-wrap:wrap; margin-bottom:16px}
.legend details{font-family:var(--mono); font-size:.72rem}
.legend summary{cursor:pointer; color:var(--mute); border:1px solid var(--line); border-radius:99px; padding:6px 12px; list-style:none; letter-spacing:.05em}
.legend summary::-webkit-details-marker{display:none}
.legend .body{margin-top:10px; border:1px solid var(--line); background:var(--surf); border-radius:var(--radius); padding:14px; display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:9px}
.legend .body div{font-size:.74rem; color:var(--mute2)}
.legend .body b{color:var(--ink)}

.claim{border:1px solid var(--line); background:var(--surf); border-radius:var(--radius); padding:17px 18px; margin-bottom:14px}
.claim .stmt{font-family:var(--display); font-weight:500; font-size:1.05rem; line-height:1.35; margin-bottom:13px}
.claim .stmt::before{content:"// claim"; display:block; font-family:var(--mono); font-weight:400; font-size:.64rem; letter-spacing:.14em; color:var(--mute); margin-bottom:5px; text-transform:uppercase}
.carriers{display:flex; flex-direction:column; gap:7px}
.carrier{display:flex; align-items:center; gap:9px; flex-wrap:wrap; padding:8px 10px; border:1px solid var(--line); border-radius:8px; background:#0e1014; font-size:.82rem; cursor:help}
.carrier .src{font-weight:600; min-width:120px}
.kind{font-family:var(--mono); font-size:.6rem; letter-spacing:.08em; padding:2px 7px; border-radius:4px; border:1px solid var(--line); color:var(--mute2); white-space:nowrap; text-transform:uppercase}
.attr{font-family:var(--mono); font-size:.62rem; color:var(--mute); display:inline-flex; align-items:center; gap:4px}
.attr.prim{color:var(--cyan)} .attr.orig{color:var(--cyan)} .attr.echo{color:var(--red)}
.carrier .motive{flex-basis:100%; font-size:.74rem; color:var(--mute); border-top:1px dashed var(--line); margin-top:3px; padding-top:6px}
.strongest{margin-top:12px; font-size:.85rem; color:var(--mute2); border-left:2px solid var(--cyan); padding:4px 0 4px 12px}
.strongest b{font-family:var(--mono); font-size:.64rem; letter-spacing:.1em; color:var(--cyan); display:block; text-transform:uppercase; margin-bottom:2px}
.opp{margin-top:13px; border:1px dashed rgba(229,52,43,.4); border-radius:8px; padding:12px 13px; background:rgba(229,52,43,.04)}
.opp .lbl{font-family:var(--mono); font-size:.64rem; letter-spacing:.1em; color:var(--red); text-transform:uppercase; margin-bottom:7px; display:flex; align-items:center; gap:7px}
.opp .stmt2{font-size:.92rem; margin-bottom:9px; font-weight:600}
.opp .why{font-size:.8rem; color:var(--mute2); margin-top:9px}
.opp .why b{color:var(--ink)}

.mfg{border:1px solid var(--red); background:rgba(229,52,43,.07); border-radius:var(--radius); padding:14px 16px; margin:16px 0; font-size:.88rem}
.mfg .lbl{font-family:var(--mono); font-size:.66rem; letter-spacing:.12em; color:var(--red); text-transform:uppercase; margin-bottom:6px}

.timeline{border-left:2px solid var(--line); margin-left:6px; padding-left:0}
.tl-item{position:relative; padding:0 0 18px 22px}
.tl-item::before{content:""; position:absolute; left:-7px; top:4px; width:12px; height:12px; border-radius:50%; background:var(--bg); border:2px solid var(--red)}
.tl-item .d{font-family:var(--mono); font-size:.68rem; color:var(--cyan); letter-spacing:.04em}
.tl-item .e{font-weight:600; font-size:.92rem; margin:2px 0}
.tl-item .s{font-size:.8rem; color:var(--mute)}

.scenario{border:1px solid var(--line); background:var(--surf); border-radius:var(--radius); padding:15px 16px; margin-bottom:12px}
.scenario .lbl{font-family:var(--mono); font-size:.62rem; letter-spacing:.14em; color:#b9a9e6; text-transform:uppercase; margin-bottom:7px}
.scenario .st{font-weight:600; font-size:.98rem; margin-bottom:9px}
.scenario .rests{font-family:var(--mono); font-size:.74rem; color:var(--mute2)}
.scenario .rests b{color:var(--mute); display:block; font-size:.6rem; letter-spacing:.1em; text-transform:uppercase; margin-bottom:4px}
.scenario .rests li{margin:3px 0 3px 16px}
.scenario .note{font-size:.74rem; color:var(--mute); margin-top:9px; font-style:italic}

/* ---------- gate / lock ---------- */
.locked-wrap{position:relative}
.locked-wrap .blurred{filter:blur(7px); opacity:.5; pointer-events:none; user-select:none}
.gate{
  position:absolute; inset:0; display:flex; align-items:center; justify-content:center; padding:20px;
  background:radial-gradient(circle at 50% 40%, rgba(10,10,11,.55), rgba(10,10,11,.92));
}
.gate-card{max-width:440px; text-align:center; border:1px solid var(--line); background:var(--surf); border-radius:var(--radius); padding:24px 24px 22px}
.gate-card .glbl{font-family:var(--mono); font-size:.66rem; letter-spacing:.14em; color:var(--cyan); text-transform:uppercase; margin-bottom:9px}
.gate-card h3{font-family:var(--display); font-weight:600; font-size:1.3rem; margin-bottom:9px; letter-spacing:-.01em}
.gate-card p{color:var(--mute2); font-size:.9rem; margin-bottom:14px}
.gate-card ul{text-align:left; margin:0 auto 16px; max-width:330px; list-style:none}
.gate-card li{font-size:.84rem; color:var(--mute2); padding:5px 0 5px 22px; position:relative}
.gate-card li::before{content:"+"; position:absolute; left:2px; color:var(--cyan); font-family:var(--mono)}
.btn{display:inline-flex; align-items:center; gap:8px; font-family:var(--mono); font-size:.78rem; letter-spacing:.05em; border:0; border-radius:99px; padding:11px 22px; cursor:pointer; transition:.15s}
.btn.primary{background:var(--cyan); color:#06222a; font-weight:500}
.btn.primary:hover{filter:brightness(1.08)}
.btn.red{background:var(--red); color:#fff}
.btn.ghost{background:transparent; border:1px solid var(--line); color:var(--mute2)}
.btn.ghost:hover{color:var(--ink); border-color:#3a404c}
.gate-card .fine{font-size:.7rem; color:var(--mute); margin-top:12px; font-family:var(--mono)}

/* ---------- modal ---------- */
.modal-bg{position:fixed; inset:0; z-index:100; background:rgba(5,5,6,.78); backdrop-filter:blur(5px); display:none; align-items:center; justify-content:center; padding:20px}
.modal-bg.show{display:flex}
.modal{max-width:430px; width:100%; border:1px solid var(--line); background:var(--surf); border-radius:14px; padding:26px}
.modal .glbl{font-family:var(--mono); font-size:.66rem; letter-spacing:.14em; color:var(--red); text-transform:uppercase; margin-bottom:9px}
.modal h3{font-family:var(--display); font-weight:600; font-size:1.4rem; margin-bottom:8px; letter-spacing:-.01em}
.modal p{color:var(--mute2); font-size:.9rem; margin-bottom:16px}
.modal form{display:flex; flex-direction:column; gap:10px}
.modal input{background:#0e1014; border:1px solid var(--line); border-radius:8px; padding:12px 14px; color:var(--ink); font-family:var(--mono); font-size:.85rem; outline:none}
.modal input:focus{border-color:var(--cyan)}
.modal .fine{font-size:.7rem; color:var(--mute); margin-top:6px; font-family:var(--mono)}
.modal .x{float:right; cursor:pointer; color:var(--mute); font-family:var(--mono); font-size:.9rem; margin-top:-6px}

/* ---------- footer ---------- */
footer{border-top:1px solid var(--line); margin-top:40px; padding:22px; text-align:center}
footer .foot-brand{display:inline-flex; align-items:center; gap:9px; font-family:var(--display); font-weight:700; letter-spacing:.06em}
footer svg{width:24px; height:auto}
footer .meta{font-family:var(--mono); font-size:.7rem; color:var(--mute); margin-top:9px; letter-spacing:.04em}

.hidden{display:none !important}
@media(max-width:640px){
  .statusline{display:none}
  main{padding:18px 14px 70px}
  .carrier .src{min-width:0}
}

/* ---------- globe hero (persists outside #app) ---------- */
#globeWrap{display:none; max-width:1340px; margin:20px auto 0; padding:0 22px}
#globeWrap.show{display:block}
#globeWrap.globe-failed{display:none !important}
#globeStage{position:relative; height:clamp(340px,50vh,540px); border:1px solid var(--line); border-radius:var(--radius); overflow:hidden;
  background:radial-gradient(circle at 50% 58%, #0e1014 0%, #070708 72%)}
#globe{position:absolute; inset:0}
#globe canvas{display:block; outline:none}
.globe-corner{position:absolute; top:14px; left:16px; font-family:var(--mono); font-size:.68rem; letter-spacing:.14em; color:var(--mute); text-transform:uppercase; pointer-events:none}
.globe-corner b{color:var(--ink)}
.globe-ov{position:absolute; left:0; right:0; bottom:0; display:flex; align-items:flex-end; justify-content:space-between; gap:14px; padding:16px; pointer-events:none;
  background:linear-gradient(transparent, rgba(7,7,8,.6))}
.globe-ov .l{font-family:var(--mono); font-size:.7rem; letter-spacing:.1em; color:var(--mute2); text-transform:uppercase}
.globe-ov .l b{color:var(--red)}
.globe-ov .hint{font-family:var(--mono); font-size:.66rem; letter-spacing:.06em; color:var(--mute); text-align:right}

/* ---------- where it stands now (situation header) ---------- */
.standsnow{margin-top:14px; border-left:2px solid var(--red); padding:7px 0 7px 13px}
.standsnow .snlbl{display:block; font-family:var(--mono); font-size:.62rem; letter-spacing:.14em; color:var(--red); text-transform:uppercase; margin-bottom:4px}
.standsnow .sntxt{font-size:.92rem; color:var(--mute2); line-height:1.45}
.standsnow .snd{font-family:var(--mono); font-size:.74rem; color:var(--cyan); margin-right:7px}
@media(max-width:640px){ #globeWrap{padding:0 14px} #globeStage{height:clamp(280px,44vh,420px)} .globe-ov .hint{display:none} }
</style>
<script defer src="https://unpkg.com/globe.gl"></script>
</head>
<body>

<!-- ============ TOP BAR ============ -->
<header>
  <div class="brand" onclick="goBoard()">
    <svg viewBox="0 0 820 540" aria-hidden="true">
      <g fill="none" stroke="#E5342B" stroke-width="40" stroke-linecap="round" stroke-linejoin="round">
        <path d="M132 152 C290 80 530 80 690 150"/>
        <path d="M150 252 C300 168 512 170 662 214"/>
        <path d="M662 214 C548 300 322 312 150 252"/>
        <path d="M322 306 C318 376 322 432 292 476"/>
        <path d="M470 300 C582 360 700 360 712 286 C718 246 668 242 678 296"/>
